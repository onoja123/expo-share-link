{
  "name": "expo-share-link",
  "version": "0.1.0",
  "description": "Share a link with a title and icon in the native share sheet (iOS LinkPresentation, Android sharesheet preview, Web Share API)",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "expo",
    "expo-module",
    "react-native",
    "share",
    "share-sheet",
    "link-presentation",
    "lplinkmetadata",
    "sharesheet",
    "web-share-api"
  ],
  "repository": "https://github.com/onoja123/expo-share-link",
  "bugs": {
    "url": "https://github.com/onoja123/expo-share-link/issues"
  },
  "author": "Okpe Onoja Godwin <gkenny896@gmail.com> (https://github.com/onoja123)",
  "license": "MIT",
  "homepage": "https://github.com/onoja123/expo-share-link#readme",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~54.0.37",
    "expo-modules-core": "~3.0.30",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "prettier": "^3.0.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "expo-asset": "*",
    "react": "*",
    "react-native": "*"
  },
  "sideEffects": false
}
